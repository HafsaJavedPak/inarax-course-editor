{
  "$id": "https://inara.dev/course-publishing-protocol/1.0/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "assets": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "max_bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "content_types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "max_bytes",
                "content_types"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "delete": {
          "type": "boolean"
        },
        "preview": {
          "type": "boolean"
        }
      },
      "required": [
        "assets",
        "delete",
        "preview"
      ]
    },
    "content": {
      "type": "object",
      "properties": {
        "block_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "block_types"
      ]
    },
    "max_package_bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "protocol",
    "host",
    "capabilities",
    "content",
    "max_package_bytes"
  ]
}
