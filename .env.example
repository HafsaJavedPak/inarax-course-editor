# Copy to .env.local and fill in.

# Where Save publishes courses: protocol | none (publishing off; Save only saves locally)
PLATFORM_ADAPTER=none

# Any host that implements the Course Publishing Protocol (contract/README.md).
# For inara-next: <inara-next URL>/api/integrations/course-editor
PLATFORM_URL=http://localhost:3000/api/integrations/course-editor
# The signing key pair. The host is configured with the same pair
# (inara-next: COURSE_EDITOR_KEYS=<id>:<secret>). Generate a secret with:
#   openssl rand -base64 36
PLATFORM_KEY_ID=
PLATFORM_KEY_SECRET=

# This editor's public address. Images the platform can't store are linked
# from here instead of the address they were uploaded on (often localhost).
EDITOR_PUBLIC_URL=

# Optional: folder holding course/ and uploads/ (default: this folder)
# DATA_DIR=/var/data
