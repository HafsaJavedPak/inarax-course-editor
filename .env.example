# Copy to .env.local. See docs/platform-integration.md.

# Where Save publishes courses: inara-next | none (publishing off; Save only saves locally)
PLATFORM_ADAPTER=none

# inara-next (when PLATFORM_ADAPTER=inara-next)
INARA_API_URL=http://127.0.0.1:3000
# none = inara-next running locally with its dev auth bypass; bearer = send INARA_API_TOKEN
INARA_AUTH=none
INARA_API_TOKEN=
# Organization new courses belong to (default: the admin's first organization)
INARA_ORGANIZATION_ID=
# Copy editor-uploaded images to inara-next's storage (true/false)
INARA_UPLOAD_ASSETS=true
# This editor's public address. Images inara-next can't store (no storage set up,
# or a type it doesn't accept) are linked from here, e.g. https://editor.example.com
EDITOR_PUBLIC_URL=

# Optional: folder holding course/ and uploads/ (default: this folder)
# DATA_DIR=/var/data
