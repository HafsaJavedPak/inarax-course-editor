# Copy to .env.local and fill in.

# The database (courses, lessons, workspaces). One of:
#   postgres://user:password@host:5432/db   a Postgres server (Render Postgres in production)
#   pglite:./.data/pglite                   PGlite: Postgres in-process, no server needed (local work)
# The app must not connect as a Postgres superuser: superusers skip row-level
# security, the database's own check that keeps workspaces apart.
# Postgres needs `npm run db:migrate` before the first start (and after updates);
# PGlite is migrated automatically. Courses saved as files before the database:
# `npm run db:import-files`.
EDITOR_DATABASE_URL=pglite:./.data/pglite

# Where Save publishes courses: protocol | none (publishing off; Save only saves locally)
PLATFORM_ADAPTER=none

# Any host that implements the Course Publishing Protocol (contract/README.md).
# For inara-next: <inara-next URL>/api/integrations/course-editor
PLATFORM_URL=http://localhost:3000/api/integrations/course-editor

# Keys (protocol 2.0): each side has its OWN Ed25519 key pair and only shares
# the public half. Nothing secret is shared between the editor and the platform.
#
# The editor's private keys, a JSON list of JWKs, active key first. Make one
# with `npm run keys:generate`. Their public halves are served at
# /.well-known/jwks.json, where the platform reads them (inara-next finds them
# from its COURSE_EDITOR_URL). Rotate: put a new key first, deploy, then remove
# the old one once the platform has picked up the new one.
EDITOR_PRIVATE_KEYS=
# Where the platform publishes ITS public keys (checks launch tokens and its
# events). Default: <PLATFORM_URL>/v1/jwks. When the platform rotates its key,
# sessions started with the old key end within about a minute.
# PLATFORM_JWKS_URL=

# With PLATFORM_ADAPTER=protocol, people sign in through the platform (its
# Course editor link sends a launch token to /launch); the editor has no
# accounts of its own. The platform needs COURSE_EDITOR_URL set to this
# editor's address. With PLATFORM_ADAPTER=none there's no sign-in (local work).

# Local testing only: keep signing in through the platform, but don't publish
# (Save only saves here). For `npm run dev:launch`, whose test users don't exist
# on the platform; it also needs PLATFORM_JWKS_URL=http://localhost:3002/jwks.json.
# PLATFORM_PUBLISHING=off

# This editor's public address. Images the platform can't store are linked
# from here instead of the address they were uploaded on (often localhost).
EDITOR_PUBLIC_URL=

# Optional: folder holding uploads/ (and course/ from before the database; default: this folder)
# DATA_DIR=/var/data

# Live co-editing (docs/collaboration/phase-4.md). Off unless COLLAB_PUBLIC_URL
# and COLLAB_TICKET_SECRET are set. With it on, lessons are edited only through
# the collaboration gateway (npm run collab, or embedded in `npm run dev`).
# COLLAB_PUBLIC_URL=ws://localhost:1234          # wss://… in production
# COLLAB_TICKET_SECRET=                           # ≥ 32 characters, same value for the app and the gateway
# COLLAB_INTERNAL_URL=http://localhost:1234       # the gateway's private address (flush before submit/publish)
# COLLAB_INTERNAL_SECRET=                         # ≥ 32 characters, same value for both
# COLLAB_PORT=1234                                # the gateway's port (Render sets PORT)
# Local work with PGlite: run the gateway inside the dev server (one process can open PGlite).
# COLLAB_EMBEDDED=1
