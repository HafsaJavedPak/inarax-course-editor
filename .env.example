# Copy to .env.local and fill in.

# The database (courses, lessons, workspaces). One of:
#   postgres://user:password@host:5432/db   a Postgres server (Render Postgres in production)
#   pglite:./.data/pglite                   PGlite: Postgres in-process, no server needed (local work)
# The app must not connect as a Postgres superuser: superusers skip row-level
# security, the database's own check that keeps workspaces apart.
# Postgres needs `npm run db:migrate` before the first start (and after updates);
# PGlite is migrated automatically. Courses saved as files before the database:
# `npm run db:import-files`.
EDITOR_DATABASE_URL=pglite:./.data/pglite

# Where Save publishes courses: protocol | none (publishing off; Save only saves locally)
PLATFORM_ADAPTER=none

# Any host that implements the Course Publishing Protocol (contract/README.md).
# For inara-next: <inara-next URL>/api/integrations/course-editor
PLATFORM_URL=http://localhost:3000/api/integrations/course-editor

# Keys (protocol 2.0): each side has its OWN Ed25519 key pair and only shares
# the public half. Nothing secret is shared between the editor and the platform.
#
# The editor's private keys, a JSON list of JWKs, active key first. Make one
# with `npm run keys:generate`. Their public halves are served at
# /.well-known/jwks.json, where the platform reads them (inara-next finds them
# from its COURSE_EDITOR_URL). Rotate: put a new key first, deploy, then remove
# the old one once the platform has picked up the new one.
EDITOR_PRIVATE_KEYS=
# Where the platform publishes ITS public keys (checks launch tokens and its
# events). Default: <PLATFORM_URL>/v1/jwks. When the platform rotates its key,
# sessions started with the old key end within about a minute.
# PLATFORM_JWKS_URL=

# With PLATFORM_ADAPTER=protocol, people sign in through the platform (its
# Course editor link sends a launch token to /launch); the editor has no
# accounts of its own. The platform needs COURSE_EDITOR_URL set to this
# editor's address. With PLATFORM_ADAPTER=none there's no sign-in (local work).

# Local testing only: keep signing in through the platform, but don't publish
# (Save only saves here). For `npm run dev:launch`, whose test users don't exist
# on the platform; it also needs PLATFORM_JWKS_URL=http://localhost:3002/jwks.json.
# PLATFORM_PUBLISHING=off

# This editor's public address. Used to build full image URLs (lesson image_url
# must be a full URL) and for images the platform can't store. Uploads are
# private (a signed-in session is needed to load one), so a link from here
# doesn't reach learners: the platform needs its own image storage.
EDITOR_PUBLIC_URL=

# Optional: folder holding uploads/ (and course/ from before the database; default: this folder)
# DATA_DIR=/var/data

# Where uploaded and AI-generated files are kept. Unset: the disk (DATA_DIR/uploads).
# With ALL FOUR set: private Firebase Storage objects under tenants/<tenant>/<course>/
# (the same service and settings inara-next uses for its lesson images). Needed by the
# app and the AI worker. Keep the literal \n sequences in the private key.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET=
# Files from before tenant scoping: `npm run uploads:migrate` (dry run), then `-- --apply`.

# Live co-editing (docs/collaboration/phase-4.md). Off unless COLLAB_PUBLIC_URL
# and COLLAB_TICKET_SECRET are set. With it on, lessons are edited only through
# the collaboration gateway (npm run collab, or embedded in `npm run dev`).
# COLLAB_PUBLIC_URL=ws://localhost:1234          # wss://… in production
# COLLAB_TICKET_SECRET=                           # ≥ 32 characters, same value for the app and the gateway
# COLLAB_INTERNAL_URL=http://localhost:1234       # the gateway's private address (flush before submit/publish)
# COLLAB_INTERNAL_SECRET=                         # ≥ 32 characters, same value for both
# COLLAB_PORT=1234                                # the gateway's port (Render sets PORT)
# Local work with PGlite: run the gateway inside the dev server (one process can open PGlite).
# COLLAB_EMBEDDED=1

# AI generation (docs: the C1 AI job core). Off unless AI_ENABLED=1. The job is
# persisted and queued; the worker (npm run ai:worker, its own Render service)
# claims it, generates with the job's provider and stages a candidate — nothing
# changes a course until a creator accepts (and that apply path is C5).
# AI_ENABLED=1
# AI_DEFAULT_PROVIDER=fake                        # the adapter a new job uses: fake | openai
# Images and video (worker side): OpenAI itself (gpt-image, Sora), with its own key (the text
# adapter above may point at another service). Without a key, image and video jobs use the
# default provider (fake locally) or are refused with 503 when it can't make them.
# OPENAI_MEDIA_API_KEY=sk-...
# OPENAI_MEDIA_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VIDEO_MODEL=sora-2
# AI_MEDIA_PROVIDER=                              # force one: fake | openai-media
# AI_WORKER_URL=http://localhost:4321             # the worker's private address (wake/estimate; optional)
# AI_WORKER_SECRET=                               # ≥ 32 characters, same value for the app and the worker
# A real text provider (the adapter is OpenAI-compatible: OpenAI, Groq, or any
# gateway/proxy). The key is read by the WORKER only, never the app or the database.
# AI_DEFAULT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1       # override for a gateway/proxy
#   Groq example (OpenAI-compatible): OPENAI_API_KEY=gsk-... , OPENAI_MODEL=openai/gpt-oss-120b ,
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1 (Groq rotates its model list often — check
#   GET /openai/v1/models; current text models include openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
# Local work: with PGlite the AI worker runs inside the dev server automatically (one process
# can open PGlite). Set AI_EMBEDDED=0 to opt out and run `npm run ai:worker` against a real Postgres.
#
# AI budgets & quotas (C2): each workspace gets a monthly spend cap and a live-job
# concurrency cap. Unset means no monthly cap; the concurrency default is 4. Both can
# be overridden per workspace in its settings (tenants.settings.ai).
# AI_MONTHLY_BUDGET=20                             # USD/month per workspace (unset = unlimited)
# AI_CONCURRENCY=4                                 # max live AI jobs per workspace at once
